---
// client/src/pages/Home.tsx のページ本体（Header + main セクション群）の移植。
// SEO/head は Base レイアウト側が担当するため、ここでは body 内容のみを描画する。
import Header from "../Header.astro";
import Hero from "./Hero.astro";
import Projects from "./Projects.astro";
import Community from "./Community.astro";
import Profile from "./Profile.astro";
import Blog from "./Blog.astro";
import Contact from "./Contact.astro";
import type { Locale } from "../../i18n";

export interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
---

<div
  class="min-h-screen bg-background text-foreground font-sans selection:bg-primary selection:text-black overflow-x-hidden"
>
  {/* CRT Effects */}
  <div class="fixed inset-0 z-50 pointer-events-none">
    <div class="scanline"></div>
  </div>

  {/* Navigation */}
  <Header locale={locale} path="/" variant="home" />

  <main class="flex-1 relative z-10 pt-16">
    <Hero locale={locale} />
    <Projects locale={locale} />
    <Community locale={locale} />
    <Profile locale={locale} />
    <Blog locale={locale} />
    <Contact locale={locale} />
  </main>
</div>

<script>
  // 背景動画の遅延マウント: 初期HTMLに src を持たせると2MBの動画がLCP判定対象になるため、
  // ページ読込完了後に data-lazy-src から注入する（旧SPAのJS描画後マウントと同じ挙動）
  const mountLazyVideos = () => {
    document.querySelectorAll<HTMLVideoElement>("video[data-lazy-src]").forEach(video => {
      const src = video.dataset.lazySrc;
      if (!src) return;
      video.src = src;
      // 背景演出のためブラウザの自動再生ブロックは無視してよい
      video.play().catch(() => undefined);
    });
  };

  if (document.readyState === "complete") {
    mountLazyVideos();
  } else {
    window.addEventListener("load", mountLazyVideos, { once: true });
  }
</script>
