---
// client/src/pages/Home.tsx Profile Section の移植
import { useTranslations, type Locale } from "../../i18n";

export interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = useTranslations(locale);
---

<section id="about" class="py-24 relative border-b border-primary/20 bg-black">
  <div class="absolute inset-0 z-0 opacity-20">
    <img
      src="/images/profile-bg.png"
      alt="Profile Background"
      class="w-full h-full object-cover"
    />
  </div>

  <div class="container relative z-10">
    <div class="flex flex-col md:flex-row gap-16 items-center">
      <div class="w-full md:w-1/3 flex flex-col items-center gap-6">
        <div class="relative group w-48 h-48 md:w-64 md:h-64">
          <div
            class="absolute inset-0 bg-white/10 rounded-full blur-xl group-hover:blur-2xl transition-all duration-500"
          >
          </div>
          <img
            src="/images/shikino-icon.png"
            alt="Sito Sikino"
            class="w-full h-full rounded-full border-2 border-gray-500/50 relative z-10 shadow-[0_0_30px_rgba(150,150,150,0.18)] object-cover"
          />
        </div>
        {/* 名前（表記正本: Sito Sikino）。アイコン直下に配置 */}
        <div class="text-center">
          <p class="text-2xl md:text-3xl font-bold text-white tracking-wide">
            {t("home.profile.name")}
          </p>
          <p class="font-mono text-xs text-primary/80 tracking-[0.3em] mt-2">
            {t("home.profile.nameSub")}
          </p>
        </div>
      </div>

      <div class="w-full md:w-2/3 space-y-8">
        <h2 class="text-4xl md:text-5xl font-display text-white">
          <span class="text-primary">03.</span> {t("home.profile.title")}
        </h2>

        <div class="space-y-6 font-mono text-lg text-gray-300 leading-relaxed">
          <p>
            <span class="text-primary">{">"}</span> {t("home.profile.intro")}
          </p>
          <div class="space-y-2">
            <p>
              <span class="text-primary">{">"}</span> {t("home.profile.career")}
            </p>
            <div class="pl-4 space-y-3">
              <p class="text-base">{t("home.profile.award1")}</p>
              <p class="text-base">{t("home.profile.award2")}</p>
              <p class="text-base">{t("home.profile.community")}</p>
              <div class="space-y-1">
                <p class="text-base">
                  {t("home.profile.memecoin")}
                </p>
                <p class="text-[10px] text-gray-500 leading-tight opacity-70">
                  {t("home.profile.disclaimer")}
                </p>
              </div>
            </div>
          </div>
        </div>

        <div class="grid grid-cols-2 gap-4 pt-4">
          <div class="neon-shimmer neon-shimmer-gray border border-neon-magenta/25 bg-black p-4">
            <h3 class="font-display text-xl text-neon-magenta mb-2">
              {t("home.profile.skills")}
            </h3>
            <ul class="font-mono text-sm space-y-1 text-gray-400">
              <li>Vibe Coding</li>
              <li>Prompt Engineering</li>
              <li>Creative Direction</li>
              <li>Storytelling</li>
            </ul>
          </div>
          <div class="neon-shimmer neon-shimmer-gray border border-neon-amber/25 bg-black p-4">
            <h3 class="font-display text-xl text-neon-amber mb-2">
              {t("home.profile.interests")}
            </h3>
            <ul class="font-mono text-sm space-y-1 text-gray-400">
              <li>Cyberpunk, Retro future</li>
              <li>Generative Art</li>
              <li>Open Source Culture</li>
            </ul>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>
