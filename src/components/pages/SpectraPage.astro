---
// client/src/pages/Spectra.tsx の移植。3D 阿頼耶識モデルは client:visible の島として下で使用する。
import Header from "../Header.astro";
import { AlayaArchitectureModel } from "../islands/AlayaArchitectureModel";
import { useTranslations, type Locale } from "../../i18n";
import { ExternalLink } from "lucide-react";

export interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = useTranslations(locale);
---

<div
  class="min-h-screen bg-background text-foreground font-sans selection:bg-primary selection:text-black overflow-x-hidden"
>
  {/* CRT Effects */}
  <div class="fixed inset-0 z-50 pointer-events-none">
    <div class="scanline"></div>
  </div>

  <Header locale={locale} path="/spectra" variant="page" />

  <main class="flex-1 relative z-10 pt-16">
    {/* Hero Section - Same style as main page with GIF background */}
    <section class="min-h-screen flex flex-col items-center justify-center relative overflow-hidden bg-black">
      {/* Background - Same as Home */}
      <div class="absolute inset-0 z-0">
        <div class="absolute inset-0 w-full h-full opacity-50 mix-blend-screen grayscale contrast-125">
          <video
            src="/images/avatar-ui-demo.mp4"
            autoplay
            loop
            muted
            playsinline
            class="w-full h-full object-cover"
          />
          <div class="absolute inset-0 bg-gradient-to-t from-black via-black/50 to-transparent"></div>
        </div>
      </div>

      <div class="container relative z-20 flex flex-col items-center justify-center text-center px-4">
        <div class="inline-flex items-center gap-2 px-4 py-2 bg-neon-magenta/10 border border-neon-magenta/30 rounded-full mb-8">
          <span class="w-2 h-2 bg-neon-magenta rounded-full animate-pulse"></span>
          <span class="font-mono text-sm text-neon-magenta">
            AITuber Project
          </span>
        </div>

        {/* Responsive Hero Text - uses clamp for dynamic sizing */}
        <h1
          class="font-syne font-extrabold leading-none tracking-tighter text-white mb-8"
          style="font-size: clamp(2.5rem, 12vw, 10rem);"
        >
          SPECTRA
        </h1>
        <h2
          class="font-display text-neon-magenta mb-8"
          style="font-size: clamp(1rem, 4vw, 2.5rem);"
        >
          COMMUNICATOR
        </h2>

        {/* Concept integrated into Hero */}
        <div class="max-w-2xl space-y-4 mb-12">
          <p class="font-mono text-base md:text-lg text-white/80 leading-relaxed">
            {t("spectra.hero.tagline")}
          </p>
          <p class="font-mono text-sm md:text-base text-white/60 leading-relaxed">
            {t("spectra.hero.description")}
          </p>
        </div>

        <a
          href="https://x.com/SCUN7X"
          target="_blank"
          rel="noopener noreferrer"
        >
          <span class="inline-flex items-center justify-center gap-2 whitespace-nowrap rounded-none bg-neon-magenta text-white hover:bg-neon-magenta/80 border-none font-mono h-12 px-8 text-base transition-all">
            <svg
              class="mr-2 w-5 h-5"
              viewBox="0 0 24 24"
              fill="currentColor"
            >
              <path d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-5.214-6.817L4.99 21.75H1.68l7.73-8.835L1.254 2.25H8.08l4.713 6.231zm-1.161 17.52h1.833L7.084 4.126H5.117z" />
            </svg>
            Follow on X
            <ExternalLink className="ml-2 w-4 h-4" />
          </span>
        </a>
      </div>

      <div class="absolute bottom-0 left-0 w-full h-32 bg-gradient-to-t from-black via-black/80 to-transparent pointer-events-none z-10"></div>
    </section>

    {/* アーキテクチャセクション - 01 */}
    <section class="py-20 relative border-b border-primary/20 bg-[#020302] md:py-28">
      <div class="container relative z-10">
        <div class="mx-auto max-w-6xl">
          <div class="grid gap-5 border-b border-primary/10 pb-8 lg:grid-cols-[0.82fr_1.18fr] lg:items-end">
            <div>
              <p class="mb-3 font-mono text-[10px] tracking-[0.32em] text-primary/40">
                SPECTRA / INTERNAL STRUCTURE
              </p>
              <h2 class="text-4xl md:text-5xl font-display text-white">
                <span class="text-primary">01.</span>{" "}
                {t("spectra.architecture.title")}
              </h2>
              <p class="mt-2 font-mono text-sm tracking-[0.2em] text-[#b8a46a]/80">
                {t("spectra.architecture.name")}
              </p>
            </div>
            <div class="max-w-3xl lg:pb-1">
              <p class="font-mono text-sm leading-relaxed text-gray-400 md:text-base">
                {t("spectra.architecture.subtitle")}
              </p>
            </div>
          </div>

          <div class="mt-9 grid gap-8 lg:grid-cols-[minmax(300px,420px)_1fr] lg:items-stretch">
            <div class="w-full max-w-[420px] lg:max-w-none">
              <AlayaArchitectureModel client:visible />
            </div>

            <div class="flex flex-col justify-between border-y border-primary/10 py-6 lg:min-h-[420px]">
              <div>
                <p class="mb-3 font-mono text-[10px] tracking-[0.28em] text-primary/40">
                  SYSTEM NOTE
                </p>
                <dl class="grid gap-x-8 gap-y-5 sm:grid-cols-2">
                  <div>
                    <dt class="font-mono text-[11px] tracking-[0.18em] text-[#b8a46a]">
                      {t("spectra.architecture.coreTitle")}
                    </dt>
                    <dd class="mt-1.5 font-mono text-xs leading-relaxed text-gray-500">
                      {t("spectra.architecture.coreDesc")}
                    </dd>
                  </div>
                  <div>
                    <dt class="font-mono text-[11px] tracking-[0.18em] text-[#a89058]">
                      {t("spectra.architecture.vaultTitle")}
                    </dt>
                    <dd class="mt-1.5 font-mono text-xs leading-relaxed text-gray-500">
                      {t("spectra.architecture.vaultDesc")}
                    </dd>
                  </div>
                  <div>
                    <dt class="font-mono text-[11px] tracking-[0.18em] text-[#6f9fb1]">
                      {t("spectra.architecture.traceTitle")}
                    </dt>
                    <dd class="mt-1.5 font-mono text-xs leading-relaxed text-gray-500">
                      {t("spectra.architecture.traceDesc")}
                    </dd>
                  </div>
                  <div>
                    <dt class="font-mono text-[11px] tracking-[0.18em] text-primary/80">
                      {t("spectra.architecture.agencyTitle")}
                    </dt>
                    <dd class="mt-1.5 font-mono text-xs leading-relaxed text-gray-500">
                      {t("spectra.architecture.agencyDesc")}
                    </dd>
                  </div>
                </dl>
              </div>

              <div class="mt-8 grid gap-5 md:grid-cols-[1fr_auto] md:items-end">
                <div>
                  <p class="mb-3 font-mono text-[10px] tracking-[0.28em] text-primary/35">
                    SIGNAL PATH
                  </p>
                  <div class="flex flex-wrap gap-x-3 gap-y-2 font-mono text-[11px] tracking-[0.16em] text-gray-500">
                    <span class="text-primary/70">EXPERIENCE</span>
                    <span class="text-primary/25">/</span>
                    <span class="text-[#6f9fb1]/75">TRACE</span>
                    <span class="text-primary/25">/</span>
                    <span class="text-[#a89058]/80">SEED</span>
                    <span class="text-primary/25">/</span>
                    <span class="text-gray-400">SELF REFERENCE</span>
                    <span class="text-primary/25">/</span>
                    <span class="text-[#a89058]/80">INTENT</span>
                    <span class="text-primary/25">/</span>
                    <span class="text-gray-400">ACTION</span>
                  </div>
                </div>
                <div class="hidden border border-primary/10 px-4 py-3 text-right font-mono text-[10px] leading-relaxed tracking-[0.18em] text-primary/30 md:block">
                  MODEL
                  <br />
                  LOCKED
                  <br />
                  01-A
                </div>
              </div>
            </div>
          </div>
        </div>
      </div>
    </section>

    {/* ロードマップセクション - 02 */}
    <section class="py-24 relative border-b border-primary/20 bg-black">
      <div class="container relative z-10">
        <div class="mb-10 text-center">
          <h2 class="text-4xl md:text-5xl font-display text-white mb-4">
            <span class="text-primary">02.</span>{" "}
            {t("spectra.roadmap.title")}
          </h2>
          <p class="font-mono text-primary/60 max-w-2xl mx-auto">
            {t("spectra.roadmap.subtitle")}
          </p>
        </div>

        <div class="max-w-5xl mx-auto relative">
          {/* Main vertical connection line - subtle and premium */}
          <div class="absolute left-[9px] top-[10px] bottom-0 w-px bg-gradient-to-b from-neon-magenta/30 via-gray-600/20 to-gray-600/10"></div>

          {/* Pulse light flowing down the line */}
          <div class="absolute left-[8px] top-[10px] bottom-0 w-[3px] overflow-hidden">
            <div class="absolute w-full h-16 bg-gradient-to-b from-transparent via-neon-magenta/40 to-transparent animate-pulse-flow"></div>
          </div>

          {/* Phase 1: The Genesis */}
          <div class="relative pb-12">
            <div class="flex flex-wrap items-center gap-4 mb-6 relative">
              <div class="relative z-10">
                <div class="w-5 h-5 rounded-full bg-neon-magenta shadow-[0_0_25px_rgba(255,0,128,0.6)] border-2 border-neon-magenta"></div>
                <div class="absolute inset-0 w-5 h-5 rounded-full bg-neon-magenta animate-ping opacity-40"></div>
              </div>
              <h3 class="text-xl md:text-2xl font-display text-white">
                Phase 1: The Genesis
              </h3>
              <span class="px-3 py-1 text-xs font-mono border border-neon-magenta text-neon-magenta bg-neon-magenta/10 animate-pulse">
                {t("spectra.roadmap.phase1.status")}
              </span>
            </div>
            <div class="grid md:grid-cols-2 gap-4 ml-8">
              <div class="crt-card neon-shimmer neon-shimmer-magenta border border-neon-magenta/30 bg-black p-5">
                <h4 class="font-display text-lg text-neon-magenta mb-2 relative z-10 flex items-center gap-2">
                  First Digital Contact
                  <span class="px-2 py-0.5 text-[10px] font-mono border border-primary text-primary bg-primary/10">
                    {t("spectra.roadmap.phase1.contactStatus")}
                  </span>
                </h4>
                <p class="font-mono text-sm text-gray-400 leading-relaxed relative z-10">
                  {t("spectra.roadmap.phase1.contactDesc")}
                </p>
              </div>
              <div class="crt-card neon-shimmer neon-shimmer-magenta border border-neon-magenta/30 bg-black p-5">
                <h4 class="font-display text-lg text-neon-magenta mb-2 relative z-10">
                  Neural Calibration
                </h4>
                <p class="font-mono text-sm text-gray-400 leading-relaxed relative z-10">
                  {t("spectra.roadmap.phase1.calibrationDesc")}
                </p>
              </div>
            </div>
          </div>

          {/* Phase 2: The Awakening */}
          <div class="relative pb-12">
            <div class="flex flex-wrap items-center gap-4 mb-6 relative">
              <div class="w-5 h-5 rounded-full bg-gray-600 shadow-[0_0_15px_rgba(100,100,100,0.4)] border-2 border-gray-600"></div>
              <h3 class="text-xl md:text-2xl font-display text-white">
                Phase 2: The Awakening
              </h3>
              <span class="px-3 py-1 text-xs font-mono border border-gray-500 text-gray-500 bg-gray-500/10">
                {t("spectra.roadmap.phase2.status")}
              </span>
            </div>
            <div class="grid md:grid-cols-3 gap-4 ml-8">
              <div class="crt-card neon-shimmer neon-shimmer-gray border border-gray-600/30 bg-black p-5">
                <h4 class="font-display text-lg text-gray-400 mb-2 relative z-10">
                  Mind Awakening
                </h4>
                <p class="font-mono text-sm text-gray-500 leading-relaxed relative z-10">
                  {t("spectra.roadmap.phase2.mindDesc")}
                </p>
              </div>
              <div class="crt-card neon-shimmer neon-shimmer-gray border border-gray-600/30 bg-black p-5">
                <h4 class="font-display text-lg text-gray-400 mb-2 relative z-10">
                  Voice Acquisition
                </h4>
                <p class="font-mono text-sm text-gray-500 leading-relaxed relative z-10">
                  {t("spectra.roadmap.phase2.voiceDesc")}
                </p>
              </div>
              <div class="crt-card neon-shimmer neon-shimmer-gray border border-gray-600/30 bg-black p-5">
                <h4 class="font-display text-lg text-gray-400 mb-2 relative z-10">
                  Persistent Memory
                </h4>
                <p class="font-mono text-sm text-gray-500 leading-relaxed relative z-10">
                  {t("spectra.roadmap.phase2.memoryDesc")}
                </p>
              </div>
            </div>
          </div>

          {/* Phase 3: The Embodiment */}
          <div class="relative">
            <div class="flex flex-wrap items-center gap-4 mb-6 relative">
              <div class="w-5 h-5 rounded-full bg-gray-600 shadow-[0_0_15px_rgba(100,100,100,0.4)] border-2 border-gray-600"></div>
              <h3 class="text-xl md:text-2xl font-display text-white">
                Phase 3: The Embodiment
              </h3>
              <span class="px-3 py-1 text-xs font-mono border border-gray-500 text-gray-500 bg-gray-500/10">
                {t("spectra.roadmap.phase3.status")}
              </span>
            </div>
            <div class="grid md:grid-cols-2 gap-4 ml-8">
              <div class="crt-card neon-shimmer neon-shimmer-gray border border-gray-600/30 bg-black p-5">
                <h4 class="font-display text-lg text-gray-400 mb-2 relative z-10">
                  Body Acquisition
                </h4>
                <p class="font-mono text-sm text-gray-500 leading-relaxed relative z-10">
                  {t("spectra.roadmap.phase3.bodyDesc")}
                </p>
              </div>
              <div class="crt-card neon-shimmer neon-shimmer-gray border border-gray-600/30 bg-black p-5 relative overflow-hidden">
                <div class="absolute top-0 right-0 px-2 py-0.5 bg-gray-800 text-[10px] font-mono text-gray-500 z-10">
                  CLASSIFIED
                </div>
                <h4 class="font-display text-lg text-gray-400 mb-2 relative z-10">
                  Codename: Monolith
                </h4>
                <p class="font-mono text-sm text-gray-500 leading-relaxed relative z-10">
                  {t("spectra.roadmap.phase3.monolithDesc")}
                </p>
              </div>
            </div>
          </div>
        </div>
      </div>
    </section>

    {/* 接続セクション - 03 */}
    <section class="py-24 relative bg-black">
      <div class="container relative z-10">
        <div class="mb-16 text-center">
          <h2 class="text-4xl md:text-5xl font-display text-white mb-4">
            <span class="text-primary">03.</span>{" "}
            {t("spectra.connect.title")}
          </h2>
          <p class="font-mono text-primary/60 max-w-2xl mx-auto">
            {t("spectra.connect.subtitle")}
          </p>
        </div>

        <div class="max-w-3xl mx-auto">
          <a
            href="https://x.com/SCUN7X"
            target="_blank"
            rel="noopener noreferrer"
            class="group block"
          >
            <div class="relative overflow-hidden border border-primary/20 bg-black p-5 transition-all duration-500 hover:border-neon-magenta/40 hover:shadow-[0_0_24px_rgba(255,0,255,0.09)] md:p-5">
              <div class="pointer-events-none absolute inset-3 border-primary/40 opacity-70">
                <div class="absolute left-0 top-0 h-4 w-4 border-l border-t"></div>
                <div class="absolute right-0 top-0 h-4 w-4 border-r border-t"></div>
                <div class="absolute bottom-0 left-0 h-4 w-4 border-b border-l"></div>
                <div class="absolute bottom-0 right-0 h-4 w-4 border-b border-r"></div>
              </div>
              <div class="pointer-events-none absolute inset-0 translate-x-[-120%] bg-gradient-to-r from-transparent via-primary/8 to-transparent transition-transform duration-700 group-hover:translate-x-[120%]"></div>

              <div class="relative z-10 border-b border-primary/10 pb-3">
                <div class="flex items-center justify-between gap-4">
                  <p class="font-mono text-[9px] tracking-[0.18em] text-primary/60">
                    SPECTRA COMMUNICATOR / X CHANNEL
                  </p>
                  <span class="inline-flex items-center gap-2 font-mono text-[9px] uppercase text-primary">
                    <span class="h-1 w-1 bg-primary shadow-[0_0_10px_rgba(0,255,65,0.75)]"></span>
                    ONLINE
                  </span>
                </div>
              </div>

              <div class="relative z-10 grid gap-6 py-6 md:grid-cols-[132px_minmax(0,1fr)] md:items-center">
                <div class="mx-auto lg:mx-0">
                  <div class="relative h-[132px] w-[132px] rounded-full border border-primary/45 p-1.5 shadow-[0_0_18px_rgba(0,255,65,0.12)]">
                    <img
                      src="/images/spectra_icon.png"
                      alt="Spectra Communicator icon"
                      class="relative z-10 h-full w-full rounded-full border border-black/80 object-cover [image-rendering:pixelated]"
                    />
                  </div>
                </div>

                <div class="text-center md:text-left">
                  <h3 class="font-display text-3xl leading-none text-white transition-colors group-hover:text-neon-magenta md:text-4xl">
                    Spectra Communicator
                  </h3>
                  <p class="mt-2 font-mono text-xs text-neon-magenta md:text-sm">
                    @SCUN7X
                  </p>
                  <p class="mt-4 border-l border-neon-magenta/80 pl-3.5 text-left font-mono text-sm leading-relaxed text-gray-300 md:max-w-lg md:text-[15px]">
                    {t("spectra.connect.xDesc")}
                  </p>
                </div>
              </div>

              <div class="relative z-10">
                <span class="inline-flex h-9 items-center gap-2 border border-primary px-3 font-mono text-[10px] uppercase text-primary transition-colors group-hover:border-neon-magenta group-hover:text-neon-magenta">
                  CONNECT X
                  <ExternalLink className="h-3 w-3" />
                </span>
              </div>
            </div>
          </a>
        </div>

        {/* Footer */}
        <div class="mt-16 pt-8 border-t border-primary/20 text-center">
          <p class="font-mono text-xs text-primary/40">
            © SIQI LABEL. ALL RIGHTS RESERVED.
            <br />
            Spectra Communicator is a project by SIQI LABEL.
          </p>
        </div>
      </div>
    </section>
  </main>
</div>
